{
	"name": "YouFilter.ai - YouTube Video Filter",
	"description": "Filter YouTube videos based upon context.",
	"homepage_url": "https://youfilter.vercel.app/",
	"version": "0.1",
	"manifest_version": 3,
	"action": {
		"default_title": "YouFilter.ai",
		"default_popup": "src/popup/popup.html",
		"default_icon": {
			"16": "assets/icons/icon16.png",
			"32": "assets/icons/icon32.png",
			"64": "assets/icons/icon64.png",
			"128": "assets/icons/icon128.png"
		}
	},
	"icons": {
		"16": "assets/icons/icon16.png",
		"32": "assets/icons/icon32.png",
		"64": "assets/icons/icon64.png",
		"128": "assets/icons/icon128.png"
	},
	"background": {
		"service_worker": "src/content/background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"run_at": "document_idle",
			"matches": [
				"https://www.youtube.com/",
				"https://www.youtube.com/watch?v=*"
			],
			"js": ["src/content/contentScript.js"]
		},
		{
			"matches": [
				"https://www.youtube.com/",
				"https://www.youtube.com/watch?v=*"
			],
			"css": ["src/content/content.css"],
			"run_at": "document_start"
		}
	],
	"permissions": ["scripting", "storage"],
	"host_permissions": ["https://ytfilter.smallsmallserver.duckdns.org/analyze"]
}
